# Copy to .env for local development with functions-framework.
# In production these come from Secret Manager / --set-env-vars.

# Required: smsoffice.ge API key from https://smsoffice.ge/you/profile/integration
SMSOFFICE_API_KEY=your-smsoffice-api-key-here

# Required: approved sender ID (max 11 chars, Latin only)
SMSOFFICE_SENDER=BitCamp

# Required: shared secret that ManyChat sends in X-Auth-Token header.
# Generate with: openssl rand -hex 32
MANYCHAT_SHARED_SECRET=replace-me-with-random-string

# Optional
LOG_LEVEL=INFO
